  fma_spec_mr = 0.251; fma_spec_mg = 0.643; fma_spec_mb = 0.910;
  fma_spec_pr = 0.882; fma_spec_pg = 0.965; fma_spec_pb = 1.0;
) : fma_theme == 3 ? (
  fma_bg_r = 0.200; fma_bg_g = 0.192; fma_bg_b = 0.169;
  fma_plate_r = 0.153; fma_plate_g = 0.145; fma_plate_b = 0.125;
  fma_acc_r = 0.902; fma_acc_g = 0.620; fma_acc_b = 0.220;
  fma_hov_r = 0.920; fma_hov_g = 0.688; fma_hov_b = 0.360;
  fma_txt_r = 0.10; fma_txt_g = 0.075; fma_txt_b = 0.05;
  fma_hqt_r = 0.10; fma_hqt_g = 0.075; fma_hqt_b = 0.05;
  fma_amb_r = 0.922; fma_amb_g = 0.696; fma_amb_b = 0.376;
  fma_bord_r = 0.839; fma_bord_g = 0.643; fma_bord_b = 0.251;
  fma_spec_dr = 0.329; fma_spec_dg = 0.227; fma_spec_db = 0.063;
  fma_spec_mr = 0.839; fma_spec_mg = 0.643; fma_spec_mb = 0.251;
  fma_spec_pr = 1.0; fma_spec_pg = 0.933; fma_spec_pb = 0.745;
) : fma_theme == 4 ? (
  fma_bg_r = 0.153; fma_bg_g = 0.153; fma_bg_b = 0.243;
  fma_plate_r = 0.114; fma_plate_g = 0.114; fma_plate_b = 0.204;
  fma_acc_r = 0.600; fma_acc_g = 0.478; fma_acc_b = 0.980;
  fma_hov_r = 0.672; fma_hov_g = 0.572; fma_hov_b = 0.984;
  fma_txt_r = 0.039; fma_txt_g = 0.055; fma_txt_b = 0.102;
  fma_hqt_r = 0.039; fma_hqt_g = 0.055; fma_hqt_b = 0.102;
  fma_amb_r = 0.680; fma_amb_g = 0.582; fma_amb_b = 0.984;
  fma_bord_r = 0.431; fma_bord_g = 0.353; fma_bord_b = 0.941;
  fma_spec_dr = 0.118; fma_spec_dg = 0.086; fma_spec_db = 0.329;
  fma_spec_mr = 0.431; fma_spec_mg = 0.353; fma_spec_mb = 0.941;
  fma_spec_pr = 0.922; fma_spec_pg = 0.902; fma_spec_pb = 1.0;
) : fma_theme == 5 ? (
  fma_bg_r = 0.133; fma_bg_g = 0.200; fma_bg_b = 0.208;
  fma_plate_r = 0.090; fma_plate_g = 0.153; fma_plate_b = 0.161;
  fma_acc_r = 0.180; fma_acc_g = 0.722; fma_acc_b = 0.612;
  fma_hov_r = 0.328; fma_hov_g = 0.772; fma_hov_b = 0.682;
  fma_txt_r = 0.10; fma_txt_g = 0.075; fma_txt_b = 0.05;
  fma_hqt_r = 0.10; fma_hqt_g = 0.075; fma_hqt_b = 0.05;
  fma_amb_r = 0.344; fma_amb_g = 0.778; fma_amb_b = 0.690;
  fma_bord_r = 0.180; fma_bord_g = 0.722; fma_bord_b = 0.612;
