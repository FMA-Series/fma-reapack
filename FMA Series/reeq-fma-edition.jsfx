  fma_spec_mr = 0.180; fma_spec_mg = 0.722; fma_spec_mb = 0.612;
  fma_spec_pr = 0.843; fma_spec_pg = 1.0; fma_spec_pb = 0.957;
) : fma_theme == 6 ? (
  fma_bg_r = 0.196; fma_bg_g = 0.180; fma_bg_b = 0.169;
  fma_plate_r = 0.149; fma_plate_g = 0.133; fma_plate_b = 0.122;
  fma_acc_r = 0.851; fma_acc_g = 0.549; fma_acc_b = 0.259;
  fma_hov_r = 0.878; fma_hov_g = 0.630; fma_hov_b = 0.392;
  fma_txt_r = 0.10; fma_txt_g = 0.075; fma_txt_b = 0.05;
  fma_hqt_r = 0.10; fma_hqt_g = 0.075; fma_hqt_b = 0.05;
  fma_amb_r = 0.881; fma_amb_g = 0.639; fma_amb_b = 0.407;
